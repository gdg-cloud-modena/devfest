---
import { withUtm } from "@configs/site";
import { localizePath, type Locale } from "@i18n/index";
import { getEdition } from "@lib/content";
import { partnerLogo } from "@lib/images";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

/**
 * Partner logos of an edition, grouped by sponsorship level: centered tier
 * label, then a row of white logo tiles that shrink as the tier does.
 * Cards link to the partner page when it has content, otherwise straight
 * to the partner website (with UTM), like the old site did.
 */
interface Props {
  year: string | number;
  locale: Locale;
}

const { year, locale } = Astro.props;

const edition = await getEdition(year);
const withPage = new Set(
  (await getCollection("partners", ({ id }) => id.startsWith(`${year}/`))).map(
    (p) => p.id.split("/")[1],
  ),
);

const levels = [...edition.data.levels].sort((a, b) => a.weight - b.weight);
const groups = levels
  .map((level) => ({
    level,
    partners: edition.data.partners.filter((p) => p.level === level.code),
  }))
  .filter((g) => g.partners.length > 0);

/** Tile size per tier: the top tiers get more room, in design order. */
const tileSize: Record<string, string> = {
  main: "lg",
  diamond: "lg",
  gold: "md",
  silver: "md",
  tech: "sm",
  bronze: "sm",
  community: "sm",
  patrocini: "xs",
  media: "xs",
};
---

<div class="partner-groups">
  {
    groups.map(({ level, partners }) => (
      <section class="level" aria-label={level.title}>
        <h3 class="level-title">{level.title}</h3>
        <ul
          class:list={["row", `row--${tileSize[level.code] ?? "sm"}`]}
          role="list"
        >
          {partners.map((partner) => {
            const logo = partnerLogo(year, partner.code);
            const href = withPage.has(partner.code)
              ? localizePath(locale, `/${year}/partners/${partner.code}/`)
              : withUtm(partner.link, year);
            const external = !withPage.has(partner.code);
            return (
              <li>
                <a
                  class="logo-tile partner"
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener" : undefined}
                >
                  {logo ? (
                    <>
                      <Image src={logo} alt="" width="240" densities={[1, 2]} />
                      <span class="visually-hidden">{partner.name}</span>
                    </>
                  ) : (
                    <span class="name">{partner.name}</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .partner-groups {
    display: grid;
    gap: var(--space-m);
  }

  .level-title {
    font-size: var(--text--1);
    text-align: center;
    margin-bottom: var(--space-xs);
  }

  .row {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
  }

  .partner {
    aspect-ratio: 1;
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  .partner:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .row--lg .partner {
    width: 7.5rem;
  }

  .row--md .partner {
    width: 6.5rem;
  }

  .row--sm .partner {
    width: 5.5rem;
  }

  .row--xs .partner {
    width: 5rem;
  }

  .partner img {
    max-width: 84%;
    max-height: 84%;
  }

  .name {
    font-size: var(--text--2);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    line-height: 1.2;
  }
</style>
