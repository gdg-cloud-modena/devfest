---
import CommunitiesGrid from "@components/CommunitiesGrid.astro";
import EditionNotice from "@components/EditionNotice.astro";
import PageHeader from "@components/PageHeader.astro";
import { isCurrent } from "@configs/editions";
import { useTranslations, type Locale } from "@i18n/index";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEdition, getPage } from "@lib/content";
import { render } from "astro:content";

interface Props {
  year: string;
  locale: Locale;
}

const { year, locale } = Astro.props;
const t = useTranslations(locale);

const edition = await getEdition(year);
const intro = await getPage(locale, "communities-intro");
const IntroContent = intro ? (await render(intro)).Content : null;
---

<BaseLayout
  title={t("communities.title")}
  {locale}
  {year}
  noCtas={!isCurrent(year)}
>
  <div class="container container--inset section">
    <EditionNotice {year} {locale} />
    <PageHeader
      title={t("communities.title")}
      badge={`DevFest Modena ${year}`}
    />

    {
      IntroContent && (
        <div class="prose prose--center intro">
          <IntroContent />
        </div>
      )
    }

    <CommunitiesGrid {year} codes={edition.data.communities} />
  </div>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-l);
  }
</style>
