---
import EditionNotice from "@components/EditionNotice.astro";
import PageHeader from "@components/PageHeader.astro";
import PersonCard from "@components/PersonCard.astro";
import PromoCard from "@components/PromoCard.astro";
import { editionOf, isCurrent } from "@configs/editions";
import { localizePath, useTranslations, type Locale } from "@i18n/index";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSpeakersOfYear } from "@lib/content";
import { speakerImage } from "@lib/images";

interface Props {
  year: string;
  locale: Locale;
}

const { year, locale } = Astro.props;
const t = useTranslations(locale);
const speakers = await getSpeakersOfYear(year);

const current = isCurrent(year);
const cfs = current ? editionOf(year).callForSpeakers : undefined;
---

<BaseLayout
  title={t("speakers.title", { year })}
  {locale}
  {year}
  noCtas={!current}
>
  <div class="container container--inset section">
    <EditionNotice {year} {locale} />
    <PageHeader
      title={t("speakers.title", { year })}
      badge={`DevFest Modena ${year}`}
      lead={current ? t("speakers.teaser", { year }) : undefined}
    />

    {
      cfs?.open && (
        <div class="cfs">
          <PromoCard
            badge={t("cfs.badge")}
            title={t("cfs.title")}
            text={t("cfs.text", { year })}
            action={{ label: t("cfs.button"), href: cfs.url, external: true }}
            decor={{ shape: "cross", tone: "pink" }}
          />
        </div>
      )
    }

    <ul class="grid" role="list">
      {
        speakers.map((speaker) => (
          <li>
            <PersonCard
              name={speaker.data.name}
              image={speakerImage(speaker.id)}
              meta={speaker.data.company}
              detail={speaker.data.role}
              href={localizePath(locale, `/speakers/${speaker.id}/`)}
            />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .cfs {
    margin-bottom: var(--space-l);
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-s);
  }
</style>
